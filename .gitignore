# Machine-local state written by Claude Code and the Impeccable design hook.
# The shared settings live in .claude/settings.json and .impeccable/config.json.
.claude/settings.local.json
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json

# Snapshots and screenshots the Playwright MCP server writes while testing.
.playwright-mcp/

# Playwright CLI output (may contain credentials)
.playwright-cli/

# Working state the img2threejs skill keeps while it builds a model.
.img2threejs/
